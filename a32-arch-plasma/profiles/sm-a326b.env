# Профиль: Samsung Galaxy A32 5G (SM-A326B)
DEVICE=sm-a326b
MODEL="Samsung Galaxy A32 5G"
ARCH=aarch64
HALIUM_BASE=11

SCREEN_W=720
SCREEN_H=1600
SCREEN_DPI=270
# QT_SCALE_FACTOR=1.5

# Разделы (уточнить по `heimdall print-pit`)
PIT_BOOT=BOOT
PIT_VBMETA=VBMETA
PIT_VBMETA_SYSTEM=VBMETA_SYSTEM
PIT_DTBO=DTBO
PIT_USERDATA=USERDATA

HALIUM_DATA_DIR=/data/halium
ROOTFS_IMAGE_NAME=rootfs.img
ANDROID_IMAGE_NAME=android-rootfs.img
