# Профиль: Samsung Galaxy A32 4G (SM-A325F)
DEVICE=sm-a325f
MODEL="Samsung Galaxy A32 4G"
ARCH=aarch64
HALIUM_BASE=11

SCREEN_W=1080
SCREEN_H=2400
SCREEN_DPI=411
# QT_SCALE_FACTOR=2

# Разделы (уточнить по `heimdall print-pit`)
PIT_BOOT=BOOT
PIT_VBMETA=VBMETA
PIT_VBMETA_SYSTEM=VBMETA_SYSTEM
PIT_DTBO=DTBO
PIT_USERDATA=USERDATA

HALIUM_DATA_DIR=/data/halium
ROOTFS_IMAGE_NAME=rootfs.img
ANDROID_IMAGE_NAME=android-rootfs.img
