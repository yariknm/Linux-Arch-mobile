# /etc/environment — базовые переменные (переопределяются профилем устройства при сборке)
PLASMA_INTEGRATION_USE_PORTAL=1
QT_IM_MODULE=maliit
QT_ENABLE_HIGHDPI_SCALING=1
QT_SCALE_FACTOR_ROUNDING_POLICY=RoundPreferFloor

# === РЕЖИМ BRING-UP (software fallback, пока нет hwcomposer/libhybris) ===
QT_QPA_PLATFORM=wayland
QT_QUICK_BACKEND=software

# === РЕЖИМ HALIUM/HWCOMPOSER (включить после установки hybris-QPA и адаптации) ===
# QT_QPA_PLATFORM=hwcomposer
# EGL_PLATFORM=hwcomposer
# HALIUM_HWC_DEVICE=hwcomposer
# HYBRIS_LD_LIBRARY_PATH=/android/vendor/lib64:/android/vendor/lib64/hw:/android/vendor/lib64/egl:/android/system/lib64
# LD_LIBRARY_PATH=/usr/lib/libhybris:$LD_LIBRARY_PATH

# DPI задаётся при сборке из профиля устройства (QT_FONT_DPI=411 для SM-A325F, 270 для SM-A326B)
QT_FONT_DPI=411
